[Unit]
Description=Email Ingest Edge MTA
After=network.target

[Service]
Type=simple
User=email-ingest
Group=email-ingest
WorkingDirectory=/opt/email-ingest
ExecStart=/opt/email-ingest/email-ingest smtp --config /opt/email-ingest/config.yaml
Restart=always
RestartSec=5s

LogNamespace=email-ingest

# Allow non-root process to bind to privileged SMTP ports (25, 465, 587)
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Security sandboxing
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target