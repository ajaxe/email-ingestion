{
  "AppOptions": {
    "AppName": "email-ingestion-bff-local-dev"
  },
  "ReverseProxy": {
    "Routes": {
      "app-auth-config": {
        "ClusterId": "go-api",
        "AuthorizationPolicy": "Anonymous",
        "Order": 1,
        "Match": {
          "Path": "/app/v1/auth/config"
        }
      },
      "app-api": {
        "ClusterId": "go-api",
        "AuthorizationPolicy": "Anonymous",
        "Order": 10,
        "Match": {
          "Path": "/app/{**catch-all}"
        }
      },
      "vite-spa": {
        "ClusterId": "vite-dev",
        "Order": 100,
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "go-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://host.docker.internal:8080"
          }
        }
      },
      "vite-dev": {
        "Destinations": {
          "destination1": {
            "Address": "http://host.docker.internal:3000"
          }
        }
      }
    }
  }
}
