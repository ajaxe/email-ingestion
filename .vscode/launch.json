{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Smtp Server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/",
      "windows": {
        "cwd": "${workspaceFolder}/backend"
      },
      "args": ["smtp"]
    },
    {
      "name": "Launch Worker",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/",
      "windows": {
        "cwd": "${workspaceFolder}/backend"
      },
      "envFile": ["${workspaceFolder}/backend/.env.dev"],
      "args": ["worker", "--streams", "email,webhook"]
    },
    {
      "name": "Launch Jobs Worker",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/",
      "windows": {
        "cwd": "${workspaceFolder}/backend"
      },
      "envFile": ["${workspaceFolder}/backend/.env.dev"],
      "args": ["worker", "--streams", "jobs"]
    }, 
    {
      "name": "Launch API",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/",
      "windows": {
        "cwd": "${workspaceFolder}/backend"
      },
      "envFile": ["${workspaceFolder}/backend/.env.dev"],
      "args": ["api"]
    },
    {
      "name": "Launch Cron",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/",
      "windows": {
        "cwd": "${workspaceFolder}/backend"
      },
      "envFile": ["${workspaceFolder}/backend/.env.dev"],
      "args": ["cron"]
    },
    {
      "name": "Frontend: Vite Dev Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend/apps/dashboard/",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
  ],
  "compounds": [
    {
      "name": "Dev: Full Stack",
      "configurations": ["Launch Smtp Server", "Launch Worker", "Launch API", "Launch Cron", "Frontend: Vite Dev Server"],
      "stopAll": true
    },
    {
      "name": "Dev: Dashboard",
      "configurations": ["Launch API", "Frontend: Vite Dev Server", "Launch Jobs Worker"],
      "stopAll": true
    }
  ]
}
