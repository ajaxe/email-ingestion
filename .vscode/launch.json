{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Smtp Server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/",
      "windows": {
        "cwd": "${workspaceFolder}/backend"
      },
      "args": ["smtp"]
    },
    {
      "name": "Launch Worker",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/",
      "windows": {
        "cwd": "${workspaceFolder}/backend"
      },
      "envFile": ["${workspaceFolder}/backend/.env.dev"],
      "args": ["worker", "--streams", "email,webhook"]
    }, 
    {
      "name": "Launch API",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/",
      "windows": {
        "cwd": "${workspaceFolder}/backend"
      },
      "envFile": ["${workspaceFolder}/backend/.env.dev"],
      "args": ["api"]
    },
    {
      "name": "Launch Cron",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/",
      "windows": {
        "cwd": "${workspaceFolder}/backend"
      },
      "envFile": ["${workspaceFolder}/backend/.env.dev"],
      "args": ["cron"]
    },
  ],
  "compounds": [
    {
      "name": "Dev: Full Stack",
      "configurations": ["Launch Smtp Server", "Launch Worker", "Launch API", "Launch Cron"],
      "stopAll": true
    }
  ]
}
