# Credentials for local object storage (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Credentials for the postgres email ingestion database
EM_DATABASE_DSN=
# Encryption key is a 32-byte string used to encrypt the webhook secret in the database.
EM_ENCRYPTION_KEY=
# Auth token for the SMTP MTA service. This is used to authenticate the SMTP MTA service when forwarding emails to backend.
EM_SMTP_MTA_AUTH_TOKEN=